#: editing/forms.py:70 editing/forms.py:235
msgid "Active"
msgstr "Activă"

#: editing/forms.py:71 editing/forms.py:233
msgid "Scale"
msgstr "Scara"

#: editing/forms.py:71 editing/forms.py:233
msgid "Scale after that editing mode is active"
msgstr "Scara la care modul modificare este activ"

#: editing/forms.py:72 editing/forms.py:237
msgid "Visible"
msgstr "Vizibil"

#: editing/forms.py:73 editing/forms.py:239
msgid "Viewers"
msgstr "Vizualizatori"

#: editing/forms.py:74 editing/forms.py:240
msgid "Select user with viewer role can do editing on layer"
msgstr ""
"Selectează utilizator cu drept de vizualizare care poate să modifice stratul"

#: editing/forms.py:77 editing/forms.py:242
msgid "Select VIEWER groups can do editing on layer"
msgstr "Select grupuri de Vizualizare care pot să modifice stratul"

#: editing/forms.py:78 editing/forms.py:243
msgid "User viewer groups"
msgstr "Grupuri de vizualizare utilizator"

#: editing/forms.py:81
msgid "User adding data field"
msgstr "Câmp utilizator ce adaugă date"

#: editing/forms.py:82
msgid ""
"Optional: select layer field to store username that entered the data. Showed "
"only string field. <br>Value stored into the field it will be so structured: "
"<i>[username]</i>"
msgstr ""
"Opțional: selectează câmpul de stocare al utilizatorului ce introduce date. "
"Se arată doar câmpurile string/text. <br>Valoarea introdusă are structura: "
"<i>[username]</i>"

#: editing/forms.py:88
msgid "User editing data field"
msgstr "Câmp utilizator ce modifică date"

#: editing/forms.py:89
msgid ""
"Optional: select layer field to store username that updated the data. Showed "
"only string field. <br>Value stored into the field it will be so structured: "
"<i>[username]</i>"
msgstr ""
"Opțional: selectează câmpul de stocare al utilizatorului ce actualizează "
"date. Se arată doar câmpurile string/text. <br>Valoarea introdusă are "
"structura: <i>[username]</i>"

#: editing/forms.py:95
#| msgid "User adding data field"
msgid "User Groups adding data field"
msgstr "Câmp pentru grupurile de utilizatori care adaugă date"

#: editing/forms.py:96
#| msgid ""
#| "Optional: select layer field to store username that entered the data. "
#| "Showed only string field. <br>Value stored into the field it will be so "
#| "structured: <i>[username]</i>"
msgid ""
"Optional: select layer field to store user groups name that entered the "
"data. Showed only string field. <br>Value stored into the field it will be "
"so structured: <i>[user group name 1, user group name 2, ...]</i>"
msgstr "Opțional: selectați câmpul stratului în care să se stocheze numele grupurilor de utilizatori care au introdus datele. Sunt afișate doar câmpurile de tip șir de caractere. <br>Valoarea stocată în câmp va avea următoarea structură: <i>[numele grupului de utilizatori 1, numele grupului de utilizatori 2, ...]</i>"

#: editing/forms.py:102
#| msgid "User editing data field"
msgid "User Groups editing data field"
msgstr "Câmp pentru grupurile de utilizatori care editează date"

#: editing/forms.py:103
#| msgid ""
#| "Optional: select layer field to store username that updated the data. "
#| "Showed only string field. <br>Value stored into the field it will be so "
#| "structured: <i>[username]</i>"
msgid ""
"Optional: select layer field to store user groups name that updated the "
"data. Showed only string field. <br>Value stored into the field it will be "
"so structured: <i>[user group name 1, user group name 2, ...]</i>"
msgstr "Opțional: selectați câmpul stratului în care să se stocheze numele grupurilor de utilizatori care au actualizat datele. Sunt afișate doar câmpurile de tip șir de caractere. <br>Valoarea stocată în câmp va avea următoarea structură: <i>[numele grupului de utilizatori 1, numele grupului de utilizatori 2, ...]</i>"

#: editing/forms.py:110
msgid "Layer'style to use"
msgstr "Stilul stratului de utilizat"

#: editing/forms.py:111
msgid "Select layer style to use for editing. "
msgstr "Selectați stilul stratului de utilizat pentru editare. "

#: editing/forms.py:132
#| msgid "Check on uncheck to attive/deactive editing layer capabilities:"
msgid "Check on uncheck to active/deactive editing layer capabilities:"
msgstr "Bifați sau debifați pentru a activa/dezactiva funcțiile de editare ale stratului:"

#: editing/forms.py:134 editing/forms.py:262
#| msgid "Check on uncheck to attive/deactive editing layer capabilities:"
msgid "Check on uncheck to show layer inside the list of layers to edit:"
msgstr "Bifați sau debifați pentru a afișa stratul în lista straturilor de editat:"

#: editing/forms.py:149 editing/forms.py:270
msgid "Select viewers with 'view permission' on project that can edit layer:"
msgstr ""
"Selectează utilizatorii cu 'permisiuni de vizualizare' ce pot modifica "
"stratul:"

#: editing/forms.py:161
#| msgid ""
#| "'User adding data field' and 'User editing data field' cannot assume the "
#| "same value."
msgid ""
"'User adding data field' and 'User editing data field' and 'User group "
"adding data field' and 'User group editing data field' must be unique."
msgstr "„Câmp pentru utilizatorul care adaugă date”, „Câmp pentru utilizatorul care editează date”, „Câmp pentru grupul de utilizatori care adaugă date” și „Câmp pentru grupul de utilizatori care editează date” trebuie să fie unice."

#: editing/forms.py:230
msgid "Layers"
msgstr "Straturi"

#: editing/forms.py:231
msgid "Select layers on which to activate editing"
msgstr "Selectați straturile pentru care se activează editarea"

#: editing/forms.py:260
#| msgid "Check on uncheck to attive/deactive editing layer capabilities:"
msgid "Check on uncheck to attive/deactive editing layers capabilities:"
msgstr "Bifați sau debifați pentru a activa/dezactiva funcțiile de editare ale straturilor:"

#: editing/forms.py:300
msgid "From User"
msgstr "De la utilizatorul"

#: editing/forms.py:301
msgid "Select the user from which to take the permissions to copy"
msgstr "Selectați utilizatorul ale cărui permisiuni vor fi copiate"

#: editing/forms.py:303
msgid "To users"
msgstr "Către utilizatorii"

#: editing/forms.py:304
msgid "Select the users who will receive permissions"
msgstr "Selectați utilizatorii care vor primi permisiunile"

#: editing/forms.py:306
msgid "From Group of User"
msgstr "De la grupul de utilizatori"

#: editing/forms.py:307
msgid "Select the group df user from which to take the permissions to copy"
msgstr "Selectați grupul de utilizatori ale cărui permisiuni vor fi copiate"

#: editing/forms.py:309
msgid "To Groups of Users"
msgstr "Către grupurile de utilizatori"

#: editing/forms.py:310
msgid "Select the groups of users who will receive permissions"
msgstr "Selectați grupurile de utilizatori care vor primi permisiunile"

#: editing/forms.py:357
msgid "Single users"
msgstr "Utilizatori individuali"

#: editing/forms.py:358
msgid "Copy editing permissions from one user to one or more recipients."
msgstr "Copiați permisiunile de editare de la un utilizator către unul sau mai mulți destinatari."

#: editing/forms.py:374
#| msgid "User viewer groups"
msgid "User groups"
msgstr "Grupuri utilizatori"

#: editing/forms.py:375
msgid ""
"Copy editing permissions from one group of users to one or more recipient "
"groups."
msgstr "Copiați permisiunile de editare de la un grup de utilizatori către unul sau mai multe grupuri destinatare."

#: editing/receivers.py:308
#, python-format
msgid "Constraint validation failed for geometry: %s"
msgstr "Validare constrângere eșuată pentru geometria: %s"

#: editing/templates/editing/copy_editing_permission_form.html:7
msgid "Alert"
msgstr "Alertă"

#: editing/templates/editing/copy_editing_permission_form.html:8
msgid "Some errors on form. Check it and send again."
msgstr "Erori în formular. Verifică și retrimite."

#: editing/templates/editing/copy_editing_permission_form.html:14
#: editing/templates/editing/editing_layer_active_form.html:20
msgid "Important"
msgstr "Important"

#: editing/templates/editing/copy_editing_permission_form.html:15
msgid ""
"The following actions will change the permissions of the selected users who "
"will lose their previous settings."
msgstr "Următoarele acțiuni vor modifica permisiunile utilizatorilor selectați, care își vor pierde setările anterioare."

#: editing/templates/editing/editing_layer_active_form.html:10
msgid "Some errors on form"
msgstr "Formularul conține erori"

#: editing/templates/editing/editing_layer_active_form.html:11
msgid "Check the highlighted fields and submit again."
msgstr "Verificați câmpurile evidențiate și trimiteți din nou."

#: editing/templates/editing/editing_layer_active_form.html:21
msgid ""
"The following settings will be applied to all the layers indicated and will "
"overwrite the settings set at the single layer level."
msgstr "Următoarele setări se vor aplica tuturor straturilor indicate și vor suprascrie setările definite la nivelul fiecărui strat."

#: editing/templates/editing/layer_action.html:5
#: editing/templates/editing/project_layers_action.html:6
