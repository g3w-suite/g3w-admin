msgstr "Eroare adaugare entitate Spatialite"

#: editing/api/base/views.py:438 editing/api/base/views.py:449
#, python-format
msgid "Error changing attribute values: %s"
msgstr "Eroare la schimbarea valorii atribut: %s"

