#: editing/templates/editing/copy_editing_permission_form.html:7
#: editing/templates/editing/editing_layer_active_form.html:7
msgid "Alert"
msgstr "Alerta"

#: editing/templates/editing/copy_editing_permission_form.html:8
#: editing/templates/editing/editing_layer_active_form.html:8
msgid "Some errors on form. Check it and send again."
msgstr "Alguns erros no formulário. Verifique e envie novamente."

#: editing/templates/editing/copy_editing_permission_form.html:13
#: editing/templates/editing/editing_layer_active_form.html:14
msgid "Important"
msgstr "Importante"

#: editing/templates/editing/copy_editing_permission_form.html:14
msgid ""
"The following actions will change the permissions of the selected users who "
"will lose their previous settings."
msgstr ""
"As seguintes ações alterarão as permissões dos utilizadores selecionados, "
"que perderão as suas configurações anteriores."

#: editing/templates/editing/editing_layer_active_form.html:15
msgid ""
"The following settings will be applied to all the layers indicated and will "
"overwrite the settings set at the single layer level"
msgstr ""
"As seguintes configurações serão aplicadas a todas as camadas indicadas e "
"substituirão as configurações definidas ao nível de cada camada."

