msgstr "Grupos de visores de usuario"

#: editing/forms.py:81
msgid "User adding data field"
msgstr "Campo de datos de añadir usuario"

#: editing/forms.py:82
msgid ""
"Optional: select layer field to store username that entered the data. Showed "
"only string field. <br>Value stored into the field it will be so structured: "
"<i>[username]</i>"
msgstr ""
"Opcional: seleccione el campo de capa para almacenar el nombre de usuario "
"que ingresó los datos. Solo se muestran campos de tipo string. <br>El valor "
"almacenado en el campo tendrá la siguiente estructura: <i>[username]</i>"

#: editing/forms.py:88
msgid "User editing data field"
msgstr "Campo de datos del usuario que edita"

#: editing/forms.py:89
msgid ""
"Optional: select layer field to store username that updated the data. Showed "
"only string field. <br>Value stored into the field it will be so structured: "
"<i>[username]</i>"
msgstr ""
"Opcional: seleccione el campo de capa para almacenar el nombre de usuario "
"que actualizó los datos. Solo se muestran campos de tipo string. <br>El "
"valor almacenado en el campo tendrá la siguiente estructura: <i>[username]</"
"i>"

#: editing/forms.py:95
msgid "User Groups adding data field"
msgstr "Campo de datos de añadir grupos de usuarios"

#: editing/forms.py:96
msgid ""
"Optional: select layer field to store user groups name that entered the "
"data. Showed only string field. <br>Value stored into the field it will be "
"so structured: <i>[user group name 1, user group name 2, ...]</i>"
msgstr ""
"Opcional: seleccione el campo de capa para almacenar los nombres de grupos "
"de usuarios que ingresaron los datos. Solo se muestran campos de tipo "
"string. <br>El valor almacenado en el campo tendrá la siguiente estructura: "
"<i>[nombre del grupo 1, nombre del grupo 2, ...]</i>"

#: editing/forms.py:102
msgid "User Groups editing data field"
msgstr "Campo de datos de edición de grupos de usuarios"

#: editing/forms.py:103
msgid ""
"Optional: select layer field to store user groups name that updated the "
"data. Showed only string field. <br>Value stored into the field it will be "
"so structured: <i>[user group name 1, user group name 2, ...]</i>"
msgstr ""
"Opcional: seleccione el campo de capa para almacenar los nombres de grupos "
"de usuarios que actualizaron los datos. Solo se muestran campos de tipo "
"string. <br>El valor almacenado en el campo tendrá la siguiente estructura: "
"<i>[nombre del grupo 1, nombre del grupo 2, ...]</i>"

