#: editing/api/base/views.py:88
#, python-brace-format
msgid ""
"The feature id {} of layer {} cannot be modified because it is not locked "
"anymore"
msgstr "Obiekt o identyfikatorze {} w warstwie {} nie może zostać zmodyfikowany, ponieważ nie jest już zablokowany"

#: editing/api/base/views.py:171
msgid "Sorry but your user doesn't has 'Add Feature' capability"
msgstr "Niestety nie masz uprawnienia „Dodawanie obiektów”"

#: editing/api/base/views.py:175
msgid "Sorry but your user doesn't has 'Delete Feature' capability"
msgstr "Niestety nie masz uprawnienia „Usuwanie obiektów”"

#: editing/api/base/views.py:181
msgid ""
"Sorry but your user doesn't has 'Change or Change Attributes Features' "
"capability"
msgstr "Niestety nie masz uprawnienia „Zmiana obiektów lub ich atrybutów”"

#: editing/api/base/views.py:408 editing/api/base/views.py:411
#, python-format
msgid "Error adding feature: %s"
msgstr "Błąd dodawania obiektu: %s"

#: editing/api/base/views.py:418
msgid "Error adding feature on Spatialite provider: "
msgstr "Błąd dodawania obiektu u dostawcy SpatiaLite: "

#: editing/api/base/views.py:438 editing/api/base/views.py:449
#, python-format
msgid "Error changing attribute values: %s"
msgstr "Błąd zmiany wartości atrybutów: %s"

#: editing/api/base/views.py:444 editing/api/base/views.py:452
#, python-format
msgid "Error changing geometry: %s"
msgstr "Błąd zmiany geometrii: %s"

#: editing/api/base/views.py:564 editing/api/base/views.py:568
#, python-format
msgid "Cannot delete feature: %s"
msgstr "Nie można usunąć obiektu: %s"

#: editing/api/base/views.py:609
#, python-format
msgid "Layer %s is not editable!"
msgstr "Warstwa %s nie jest edytowalna!"

#: editing/api/base/views.py:686
#, python-format
msgid "Backend error saving layer %s: %s"
msgstr "Błąd zaplecza podczas zapisywania warstwy %s: %s"

#: editing/forms.py:70 editing/forms.py:235
msgid "Active"
msgstr "Aktywna"

#: editing/forms.py:71 editing/forms.py:233
msgid "Scale"
msgstr "Skala"

#: editing/forms.py:71 editing/forms.py:233
msgid "Scale after that editing mode is active"
msgstr "Skala, od której tryb edycji jest aktywny"

#: editing/forms.py:72 editing/forms.py:237
msgid "Visible"
msgstr "Widoczna"

#: editing/forms.py:73 editing/forms.py:239
msgid "Viewers"
msgstr "Przeglądający"

#: editing/forms.py:74 editing/forms.py:240
msgid "Select user with viewer role can do editing on layer"
msgstr "Wybierz użytkowników z rolą przeglądającego, którzy mogą edytować warstwę"

#: editing/forms.py:77 editing/forms.py:242
msgid "Select VIEWER groups can do editing on layer"
msgstr "Wybierz grupy PRZEGLĄDAJĄCYCH, które mogą edytować warstwę"

#: editing/forms.py:78 editing/forms.py:243
msgid "User viewer groups"
msgstr "Grupy użytkowników z uprawnieniami przeglądającego"

#: editing/forms.py:81
msgid "User adding data field"
msgstr "Pole użytkownika dodającego dane"

#: editing/forms.py:82
msgid ""
"Optional: select layer field to store username that entered the data. Showed "
"only string field. <br>Value stored into the field it will be so structured: "
"<i>[username]</i>"
msgstr "Opcjonalnie: wybierz pole warstwy do zapisywania nazwy użytkownika, który wprowadził dane. Wyświetlane są tylko pola tekstowe. <br>Wartość zapisana w polu będzie miała następującą strukturę: <i>[username]</i>"

#: editing/forms.py:88
msgid "User editing data field"
msgstr "Pole użytkownika edytującego dane"

#: editing/forms.py:89
msgid ""
"Optional: select layer field to store username that updated the data. Showed "
"only string field. <br>Value stored into the field it will be so structured: "
"<i>[username]</i>"
msgstr "Opcjonalnie: wybierz pole warstwy do zapisywania nazwy użytkownika, który zaktualizował dane. Wyświetlane są tylko pola tekstowe. <br>Wartość zapisana w polu będzie miała następującą strukturę: <i>[username]</i>"

#: editing/forms.py:95
msgid "User Groups adding data field"
msgstr "Pole grup użytkownika dodającego dane"

#: editing/forms.py:96
msgid ""
"Optional: select layer field to store user groups name that entered the "
"data. Showed only string field. <br>Value stored into the field it will be "
"so structured: <i>[user group name 1, user group name 2, ...]</i>"
msgstr "Opcjonalnie: wybierz pole warstwy do zapisywania nazw grup użytkownika, który wprowadził dane. Wyświetlane są tylko pola tekstowe. <br>Wartość zapisana w polu będzie miała następującą strukturę: <i>[user group name 1, user group name 2, ...]</i>"

#: editing/forms.py:102
msgid "User Groups editing data field"
msgstr "Pole grup użytkownika edytującego dane"

#: editing/forms.py:103
msgid ""
"Optional: select layer field to store user groups name that updated the "
"data. Showed only string field. <br>Value stored into the field it will be "
"so structured: <i>[user group name 1, user group name 2, ...]</i>"
msgstr "Opcjonalnie: wybierz pole warstwy do zapisywania nazw grup użytkownika, który zaktualizował dane. Wyświetlane są tylko pola tekstowe. <br>Wartość zapisana w polu będzie miała następującą strukturę: <i>[user group name 1, user group name 2, ...]</i>"

#: editing/forms.py:110
msgid "Layer'style to use"
msgstr "Styl warstwy do użycia"

#: editing/forms.py:111
msgid "Select layer style to use for editing. "
msgstr "Wybierz styl warstwy używany podczas edycji. "

#: editing/forms.py:132
msgid "Check on uncheck to active/deactive editing layer capabilities:"
msgstr "Zaznacz lub odznacz, aby włączyć lub wyłączyć możliwość edycji warstwy:"

#: editing/forms.py:134 editing/forms.py:262
msgid "Check on uncheck to show layer inside the list of layers to edit:"
msgstr "Zaznacz lub odznacz, aby wyświetlać warstwę na liście warstw do edycji:"

#: editing/forms.py:149 editing/forms.py:270
msgid "Select viewers with 'view permission' on project that can edit layer:"
msgstr "Wybierz przeglądających z uprawnieniem do wyświetlania projektu, którzy mogą edytować warstwę:"

#: editing/forms.py:161
msgid ""
"'User adding data field' and 'User editing data field' and 'User group "
"adding data field' and 'User group editing data field' must be unique."
msgstr "Pola „Użytkownik dodający dane”, „Użytkownik edytujący dane”, „Grupa użytkownika dodającego dane” i „Grupa użytkownika edytującego dane” muszą być różne."

#: editing/forms.py:230
msgid "Layers"
msgstr "Warstwy"

#: editing/forms.py:231
msgid "Select layers on which to activate editing"
msgstr "Wybierz warstwy, dla których chcesz włączyć edycję"

#: editing/forms.py:260
msgid "Check on uncheck to attive/deactive editing layers capabilities:"
msgstr "Zaznacz lub odznacz, aby włączyć lub wyłączyć możliwość edycji warstw:"

#: editing/forms.py:300
msgid "From User"
msgstr "Od użytkownika"

#: editing/forms.py:301
msgid "Select the user from which to take the permissions to copy"
msgstr "Wybierz użytkownika, którego uprawnienia chcesz skopiować"

#: editing/forms.py:303
msgid "To users"
msgstr "Do użytkowników"

#: editing/forms.py:304
msgid "Select the users who will receive permissions"
msgstr "Wybierz użytkowników, którzy otrzymają uprawnienia"

#: editing/forms.py:306
msgid "From Group of User"
msgstr "Od grupy użytkowników"

#: editing/forms.py:307
msgid "Select the group df user from which to take the permissions to copy"
msgstr "Wybierz grupę użytkowników, której uprawnienia chcesz skopiować"

#: editing/forms.py:309
msgid "To Groups of Users"
msgstr "Do grup użytkowników"

#: editing/forms.py:310
msgid "Select the groups of users who will receive permissions"
msgstr "Wybierz grupy użytkowników, które otrzymają uprawnienia"

#: editing/forms.py:357
msgid "Single users"
msgstr "Pojedynczy użytkownicy"

#: editing/forms.py:358
msgid "Copy editing permissions from one user to one or more recipients."
msgstr "Skopiuj uprawnienia do edycji od jednego użytkownika do jednego lub wielu odbiorców."

#: editing/forms.py:374
msgid "User groups"
msgstr "Grupy użytkowników"

#: editing/forms.py:375
msgid ""
"Copy editing permissions from one group of users to one or more recipient "
"groups."
msgstr "Skopiuj uprawnienia do edycji od jednej grupy użytkowników do jednej lub wielu grup odbiorców."

#: editing/receivers.py:308
#, python-format
msgid "Constraint validation failed for geometry: %s"
msgstr "Niepowodzenie weryfikacji ograniczeń geometrii: %s"

#: editing/templates/editing/copy_editing_permission_form.html:7
msgid "Alert"
msgstr "Uwaga"

#: editing/templates/editing/copy_editing_permission_form.html:8
msgid "Some errors on form. Check it and send again."
msgstr "Formularz zawiera błędy. Sprawdź go i wyślij ponownie."

#: editing/templates/editing/copy_editing_permission_form.html:14
#: editing/templates/editing/editing_layer_active_form.html:20
msgid "Important"
msgstr "Ważne"

#: editing/templates/editing/copy_editing_permission_form.html:15
msgid ""
"The following actions will change the permissions of the selected users who "
"will lose their previous settings."
msgstr "Poniższe działania zmienią uprawnienia wybranych użytkowników, którzy utracą dotychczasowe ustawienia."

#: editing/templates/editing/editing_layer_active_form.html:10
msgid "Some errors on form"
msgstr "Formularz zawiera błędy"

#: editing/templates/editing/editing_layer_active_form.html:11
msgid "Check the highlighted fields and submit again."
msgstr "Sprawdź wyróżnione pola i wyślij ponownie."

#: editing/templates/editing/editing_layer_active_form.html:21
msgid ""
"The following settings will be applied to all the layers indicated and will "
"overwrite the settings set at the single layer level."
msgstr "Poniższe ustawienia zostaną zastosowane do wszystkich wskazanych warstw i zastąpią ustawienia poszczególnych warstw."

#: editing/templates/editing/layer_action.html:5
#: editing/templates/editing/project_layers_action.html:6
msgid "Editing layer"
msgstr "Edycja warstwy"

#: editing/templates/editing/layer_action.html:8
#: editing/templates/editing/project_layers_action.html:9
msgid "Activation layer_editing"
msgstr "Włączenie layer_editing"

#: editing/templates/editing/project_layers_action.html:15
#: editing/templates/editing/project_layers_action.html:18
msgid "Copy permissions"
msgstr "Kopiuj uprawnienia"
